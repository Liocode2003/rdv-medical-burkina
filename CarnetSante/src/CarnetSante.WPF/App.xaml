<Application x:Class="CarnetSante.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CarnetSante.WPF.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Controls.xaml"/>
                <ResourceDictionary Source="Resources/Styles/DataGrid.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
            <conv:NullToInverseVisibilityConverter x:Key="NullToInverseVisibility"/>
            <conv:PageToVisibilityConverter x:Key="PageToVisibility"/>
            <conv:BoolToSidebarColorConverter x:Key="BoolToSidebarColor"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
