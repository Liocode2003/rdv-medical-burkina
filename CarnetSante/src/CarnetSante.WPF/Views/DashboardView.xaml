<UserControl x:Class="CarnetSante.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Tableau de bord" Style="{StaticResource SectionHeader}" FontSize="24"/>
                <TextBlock Text="{Binding DateAujourdhui}" FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,-8,0,0"/>
            </StackPanel>

            <!-- Stat Cards -->
            <UniformGrid Grid.Row="2" Columns="3" HorizontalAlignment="Stretch">
                <!-- Total Patients -->
                <Border Style="{StaticResource StatCard}" Margin="0,0,16,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1B5E20" Offset="0"/>
                            <GradientStop Color="#2E7D32" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="Total Patients" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#A5D6A7"/>
                        <TextBlock Text="{Binding TotalPatients}" FontSize="48" FontWeight="Bold"
                                   Foreground="White" Margin="0,8,0,0"/>
                        <TextBlock Text="Dossiers enregistrés" FontSize="12" Foreground="#C8E6C9"/>
                    </StackPanel>
                </Border>

                <!-- Hommes -->
                <Border Style="{StaticResource StatCard}" Margin="8,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0D47A1" Offset="0"/>
                            <GradientStop Color="#1565C0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="Patients Hommes" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#90CAF9"/>
                        <TextBlock Text="{Binding PatientsHommes}" FontSize="48" FontWeight="Bold"
                                   Foreground="White" Margin="0,8,0,0"/>
                        <TextBlock Text="Genre Masculin" FontSize="12" Foreground="#BBDEFB"/>
                    </StackPanel>
                </Border>

                <!-- Femmes -->
                <Border Style="{StaticResource StatCard}" Margin="16,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#880E4F" Offset="0"/>
                            <GradientStop Color="#AD1457" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="Patientes Femmes" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#F48FB1"/>
                        <TextBlock Text="{Binding PatientsFemmes}" FontSize="48" FontWeight="Bold"
                                   Foreground="White" Margin="0,8,0,0"/>
                        <TextBlock Text="Genre Féminin" FontSize="12" Foreground="#FCE4EC"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Info Section -->
            <Border Grid.Row="4" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Informations Système" Style="{StaticResource SectionHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="APPLICATION" Style="{StaticResource LblField}"/>
                            <TextBlock Text="CarnetSante - Gestion des carnets de santé" FontSize="14"/>
                            <Separator Style="{StaticResource HSeparator}"/>
                            <TextBlock Text="ORGANISME" Style="{StaticResource LblField}"/>
                            <TextBlock Text="Ministère de la Santé du Burkina Faso" FontSize="14"/>
                            <Separator Style="{StaticResource HSeparator}"/>
                            <TextBlock Text="VERSION" Style="{StaticResource LblField}"/>
                            <TextBlock Text="2.0.0 - Build 2025" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="BASE DE DONNÉES" Style="{StaticResource LblField}"/>
                            <TextBlock Text="SQLite (Local) - Chiffrement AES-256" FontSize="14"/>
                            <Separator Style="{StaticResource HSeparator}"/>
                            <TextBlock Text="PLATEFORME" Style="{StaticResource LblField}"/>
                            <TextBlock Text=".NET 8 / WPF - Windows Desktop" FontSize="14"/>
                            <Separator Style="{StaticResource HSeparator}"/>
                            <TextBlock Text="ARCHITECTURE" Style="{StaticResource LblField}"/>
                            <TextBlock Text="MVVM / Repository / EF Core 8" FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
