<Window x:Class="CarnetSante.WPF.Views.VisiteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dossier de Visite / Hospitalisation"
        Width="1000" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,16">
            <TextBlock Text="DOSSIER DE VISITE / MISE EN OBSERVATION"
                       FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>
                <!-- Informations générales -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Informations Générales" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="DATE ET HEURE D'ENTRÉE *" Style="{StaticResource LblField}"/>
                                <DatePicker SelectedDate="{Binding DateVisite}" Style="{StaticResource DpField}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="ÉTABLISSEMENT *" Style="{StaticResource LblField}"/>
                                <TextBox Text="{Binding Etablissement}" Style="{StaticResource TxtField}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Text="MÉDECIN TRAITANT" Style="{StaticResource LblField}"/>
                                <TextBox Text="{Binding MedecinTraitant}" Style="{StaticResource TxtField}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Text="MOTIF D'HOSPITALISATION *" Style="{StaticResource LblField}"/>
                                <TextBox Text="{Binding Motif}" Style="{StaticResource TxtField}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="4">
                                <TextBlock Text="DURÉE (jours)" Style="{StaticResource LblField}"/>
                                <TextBox Text="{Binding DureeHospitalisation}" Style="{StaticResource TxtField}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Histoire de la Maladie -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Histoire de la Maladie" Style="{StaticResource SectionHeader}"/>
                        <TextBox Text="{Binding HistoireMaladie}" Style="{StaticResource TxtMultiline}"
                                 MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- État Général -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="État Général (à l'admission)" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Température, Poids, Pouls, SpO2, FR, Conjonctives, État d'hydratation, État de nutrition, OMI"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,-8,0,8"/>
                        <TextBox Text="{Binding EtatGeneral}" Style="{StaticResource TxtMultiline}"
                                 MinHeight="80" AcceptsReturn="True" TextWrapping="Wrap"
                                 ToolTip="Ex: Bon / Assez Bon / Mauvais - TA: 120/80, FC: 72bpm, Temp: 37.2°C, SpO2: 98%"/>
                    </StackPanel>
                </Border>

                <!-- Examen Physique -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Examen Physique Complet" Style="{StaticResource SectionHeader}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Cardiovasculaire -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="APPAREIL CARDIOVASCULAIRE" Style="{StaticResource LblField}"/>
                                <TextBox Text="{Binding ExamenCardiovasculaire}" Style="{StaticResource TxtMultiline}"
                                         MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>
                            <!-- Pleuro-pulmonaire -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="APPAREIL PLEURO-PULMONAIRE" Style="{StaticResource LblField}"/>
                                <TextBox Text="{Binding ExamenPleuroPulmonaire}" Style="{StaticResource TxtMultiline}"
                                         MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Digestif -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="APPAREIL DIGESTIF" Style="{StaticResource LblField}"/>
                                <TextBox Text="{Binding ExamenDigestif}" Style="{StaticResource TxtMultiline}"
                                         MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>
                            <!-- Neurologique -->
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="EXAMEN NEUROLOGIQUE" Style="{StaticResource LblField}"/>
                                <TextBox Text="{Binding ExamenNeurologique}" Style="{StaticResource TxtMultiline}"
                                         MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Autres appareils -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Text="AUTRES APPAREILS" Style="{StaticResource LblField}"/>
                                <TextBox Text="{Binding ExamenAutresAppareils}" Style="{StaticResource TxtMultiline}"
                                         MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Examens complémentaires -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Examens Complémentaires" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="EXAMENS BIOLOGIQUES" Style="{StaticResource LblField}"/>
                                <TextBox Text="{Binding ExamensBiologiques}" Style="{StaticResource TxtMultiline}"
                                         MinHeight="80" AcceptsReturn="True" TextWrapping="Wrap"
                                         ToolTip="NFS, Glycémie, Urée, Créatinine, Ionogramme, Bilan hépatique, etc."/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="EXAMENS RADIOLOGIQUES" Style="{StaticResource LblField}"/>
                                <TextBox Text="{Binding ExamensRadiologiques}" Style="{StaticResource TxtMultiline}"
                                         MinHeight="80" AcceptsReturn="True" TextWrapping="Wrap"
                                         ToolTip="Radiographie, Échographie, Scanner, IRM, etc."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Diagnostic et Traitement -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Diagnostic et Traitement" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="DIAGNOSTIC RETENU" Style="{StaticResource LblField}"/>
                                <TextBox Text="{Binding Diagnostic}" Style="{StaticResource TxtMultiline}"
                                         MinHeight="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TRAITEMENT PRESCRIT" Style="{StaticResource LblField}"/>
                                <TextBox Text="{Binding Traitement}" Style="{StaticResource TxtMultiline}"
                                         MinHeight="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Évolution et Suites -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Évolution et Suites" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ÉVOLUTION CLINIQUE" Style="{StaticResource LblField}"/>
                                <TextBox Text="{Binding EvolutionClinique}" Style="{StaticResource TxtMultiline}"
                                         MinHeight="80" AcceptsReturn="True" TextWrapping="Wrap"
                                         ToolTip="Évolution jour par jour, complications, améliorations"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SUITES ET OBSERVATIONS" Style="{StaticResource LblField}"/>
                                <TextBox Text="{Binding Suites}" Style="{StaticResource TxtMultiline}"
                                         MinHeight="80" AcceptsReturn="True" TextWrapping="Wrap"
                                         ToolTip="Suites opératoires, état à la sortie, recommandations"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="OBSERVATIONS GÉNÉRALES" Style="{StaticResource LblField}"/>
                            <TextBox Text="{Binding Observations}" Style="{StaticResource TxtMultiline}"
                                     MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Click="Cancel_Click"
                        Style="{StaticResource BtnSecondary}"
                        Width="120" Margin="0,0,8,0"/>
                <Button Content="Enregistrer" Click="Save_Click"
                        Style="{StaticResource BtnPrimary}"
                        Width="140"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
