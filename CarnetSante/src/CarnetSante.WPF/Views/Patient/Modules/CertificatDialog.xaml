<Window x:Class="CarnetSante.WPF.Views.Patient.Modules.CertificatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau Certificat Médical"
        Width="580" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Annuler" Click="BtnAnnuler_Click"
                    Background="#6B7280" Foreground="White"
                    BorderThickness="0" Padding="15,8" Margin="5,0" Cursor="Hand"/>
            <Button Content="Enregistrer" Click="BtnEnregistrer_Click"
                    Background="#1A3A5C" Foreground="White"
                    BorderThickness="0" Padding="15,8" Cursor="Hand"/>
        </StackPanel>

        <ScrollViewer DockPanel.Dock="Top">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Date du certificat *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <DatePicker x:Name="DateCertificatPicker" Padding="8,6" Margin="0,0,0,10"/>
                        <TextBlock Text="Type de certificat *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox x:Name="TypeCertificatBox" IsEditable="True" Padding="8,6" Margin="0,0,0,10">
                            <ComboBoxItem Content="Origine de blessure"/>
                            <ComboBoxItem Content="Aptitude médicale"/>
                            <ComboBoxItem Content="Inaptitude médicale"/>
                            <ComboBoxItem Content="Convalescence"/>
                            <ComboBoxItem Content="Hospitalisation"/>
                            <ComboBoxItem Content="Autre"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Objet du certificat" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="ObjetBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                        <TextBlock Text="Origine (civile/militaire/accident)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="OrigineBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Contenu du certificat" FontWeight="SemiBold" Margin="0,4,0,3"/>
                <TextBox x:Name="ContenuBox" Padding="8,6" BorderBrush="#D1D5DB"
                         BorderThickness="1" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                         Margin="0,0,0,10"/>

                <TextBlock Text="Circonstances d'origine" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="CirconstancesBox" Padding="8,6" BorderBrush="#D1D5DB"
                         BorderThickness="1" Height="65" AcceptsReturn="True" TextWrapping="Wrap"
                         Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Médecin signataire" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="MedecinBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                        <TextBlock Text="N° Ordre médecins" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="NumeroOrdreBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Établissement" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="EtablissementBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                        <TextBlock Text="Imputable au service" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <CheckBox x:Name="ImputabiliteBox" Content="Oui" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Observations" FontWeight="SemiBold" Margin="0,4,0,3"/>
                <TextBox x:Name="ObservationsBox" Padding="8,6" BorderBrush="#D1D5DB"
                         BorderThickness="1" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
