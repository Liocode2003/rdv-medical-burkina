<Window x:Class="CarnetSante.WPF.Views.Patient.Modules.VisiteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvelle Visite Sanitaire"
        Width="580" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Annuler" Click="BtnAnnuler_Click"
                    Background="#6B7280" Foreground="White"
                    BorderThickness="0" Padding="15,8" Margin="5,0" Cursor="Hand"/>
            <Button Content="Enregistrer" Click="BtnEnregistrer_Click"
                    Background="#1A3A5C" Foreground="White"
                    BorderThickness="0" Padding="15,8" Cursor="Hand"/>
        </StackPanel>

        <ScrollViewer DockPanel.Dock="Top">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Date de la visite *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <DatePicker x:Name="DateVisitePicker" Padding="8,6" Margin="0,0,0,10"/>
                        <TextBlock Text="Type de visite" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox x:Name="TypeVisiteBox" Padding="8,6" Margin="0,0,0,10">
                            <ComboBoxItem Content="Annuelle" IsSelected="True"/>
                            <ComboBoxItem Content="Semestrielle"/>
                            <ComboBoxItem Content="Circonstancielle"/>
                            <ComboBoxItem Content="Systématique"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Entité médicale *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="EntiteMedicaleBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                        <TextBlock Text="Médecin" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="MedecinBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Résultats de la visite" FontWeight="SemiBold" Margin="0,4,0,3"/>
                <TextBox x:Name="ResultatsBox" Padding="8,6" BorderBrush="#D1D5DB"
                         BorderThickness="1" Height="65" AcceptsReturn="True" TextWrapping="Wrap"
                         Margin="0,0,0,10"/>

                <TextBlock Text="Diagnostics retenus" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="DiagnosticsBox" Padding="8,6" BorderBrush="#D1D5DB"
                         BorderThickness="1" Height="65" AcceptsReturn="True" TextWrapping="Wrap"
                         Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Examens prescrits" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="ExamensBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Height="65" AcceptsReturn="True" TextWrapping="Wrap"
                                 Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Traitements prescrits" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="TraitementsBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Height="65" AcceptsReturn="True" TextWrapping="Wrap"
                                 Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Aptitude (conclusion)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="AptitudeBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Prochain contrôle" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <DatePicker x:Name="ProchainControlePicker" Padding="8,6" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Observations" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="ObservationsBox" Padding="8,6" BorderBrush="#D1D5DB"
                         BorderThickness="1" Height="65" AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
