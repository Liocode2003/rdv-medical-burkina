<Window x:Class="CarnetSante.WPF.Views.Patient.Modules.VaccinationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvelle Vaccination"
        Width="580" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Annuler" Click="BtnAnnuler_Click"
                    Background="#6B7280" Foreground="White"
                    BorderThickness="0" Padding="15,8" Margin="5,0" Cursor="Hand"/>
            <Button Content="Enregistrer" Click="BtnEnregistrer_Click"
                    Background="#1A3A5C" Foreground="White"
                    BorderThickness="0" Padding="15,8" Cursor="Hand"/>
        </StackPanel>

        <ScrollViewer DockPanel.Dock="Top">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Type de vaccin" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox x:Name="TypeVaccinBox" Padding="8,6" Margin="0,0,0,10">
                            <ComboBoxItem Content="Anti-Amaril" Tag="AntiAmaril"/>
                            <ComboBoxItem Content="Anti-Tétanique" Tag="AntiTetanique"/>
                            <ComboBoxItem Content="Anti-Méningite" Tag="AntiMeningite"/>
                            <ComboBoxItem Content="Anti-Covid" Tag="AntiCovid"/>
                            <ComboBoxItem Content="Anti-Hépatite B" Tag="AntiHepatiteB"/>
                            <ComboBoxItem Content="Anti-Polio" Tag="AntiPolio"/>
                            <ComboBoxItem Content="Anti-Rage" Tag="AntiRage"/>
                            <ComboBoxItem Content="Anti-Typhoïde" Tag="AntiTyphoide"/>
                            <ComboBoxItem Content="Autre" Tag="Autre" IsSelected="True"/>
                        </ComboBox>
                        <TextBlock Text="Nom du vaccin *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="NomVaccinBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                        <TextBlock Text="Fabricant" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="FabricantBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                        <TextBlock Text="Numéro de lot" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="NumeroLotBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Date de vaccination *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <DatePicker x:Name="DateVaccinationPicker" Padding="8,6" Margin="0,0,0,10"/>
                        <TextBlock Text="N° de dose" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="NumeroDoseBox" Text="1" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                        <TextBlock Text="Voie d'administration" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox x:Name="VoieAdminBox" Padding="8,6" Margin="0,0,0,10">
                            <ComboBoxItem Content="Intramusculaire (IM)" IsSelected="True"/>
                            <ComboBoxItem Content="Sous-cutanée (SC)"/>
                            <ComboBoxItem Content="Intradermique (ID)"/>
                            <ComboBoxItem Content="Orale (PO)"/>
                        </ComboBox>
                        <TextBlock Text="Site d'injection" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="SiteInjectionBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                        <TextBlock Text="Prochaine injection prévue" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <DatePicker x:Name="ProchaineInjectionPicker" Padding="8,6" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Médecin vaccinateur" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="MedecinBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Établissement" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="EtablissementBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Réaction post-vaccinale" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="ReactionBox" Padding="8,6" BorderBrush="#D1D5DB"
                         BorderThickness="1" Height="55" AcceptsReturn="True" TextWrapping="Wrap"
                         Margin="0,0,0,10"/>

                <TextBlock Text="Observations" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="ObservationsBox" Padding="8,6" BorderBrush="#D1D5DB"
                         BorderThickness="1" Height="55" AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
