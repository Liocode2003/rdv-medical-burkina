<Window x:Class="CarnetSante.WPF.Views.Patient.Modules.DecisionReformeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvelle Décision de Réforme"
        Width="600" Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Annuler" Click="BtnAnnuler_Click"
                    Background="#6B7280" Foreground="White"
                    BorderThickness="0" Padding="15,8" Margin="5,0" Cursor="Hand"/>
            <Button Content="Enregistrer" Click="BtnEnregistrer_Click"
                    Background="#DC2626" Foreground="White"
                    BorderThickness="0" Padding="15,8" Cursor="Hand"/>
        </StackPanel>

        <ScrollViewer DockPanel.Dock="Top">
            <StackPanel>
                <!-- En-tête commission -->
                <TextBlock Text="Commission de réforme" FontWeight="Bold" Foreground="#1A3A5C"
                           FontSize="13" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Date de la décision *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <DatePicker x:Name="DateDecisionPicker" Padding="8,6" Margin="0,0,0,10"/>
                        <TextBlock Text="Lieu de la commission" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="LieuCommissionBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="N° de la décision *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="NumeroDecisionBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                        <TextBlock Text="Date de réunion" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <DatePicker x:Name="DateReunionPicker" Padding="8,6" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Composition de la commission" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="CompositionBox" Padding="8,6" BorderBrush="#D1D5DB"
                         BorderThickness="1" Height="55" AcceptsReturn="True" TextWrapping="Wrap"
                         Margin="0,0,0,10"/>

                <!-- Diagnostic retenu -->
                <TextBlock Text="Diagnostic médical" FontWeight="Bold" Foreground="#1A3A5C"
                           FontSize="13" Margin="0,8,0,6"/>
                <TextBlock Text="Diagnostic retenu *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="DiagnosticBox" Padding="8,6" BorderBrush="#D1D5DB"
                         BorderThickness="1" Height="65" AcceptsReturn="True" TextWrapping="Wrap"
                         Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Code CIM-10" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="CodeCIM10Box" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Taux d'invalidité" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="TauxInvaliditeBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

                <!-- Décision -->
                <TextBlock Text="Décision prononcée" FontWeight="Bold" Foreground="#1A3A5C"
                           FontSize="13" Margin="0,4,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Décision *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox x:Name="DecisionBox" Padding="8,6" Margin="0,0,0,10">
                            <ComboBoxItem Content="Maintien" Tag="Maintien" IsSelected="True"/>
                            <ComboBoxItem Content="Réforme définitive" Tag="RefomeDefinitive"/>
                            <ComboBoxItem Content="Réforme temporaire" Tag="RefomeTemporaire"/>
                            <ComboBoxItem Content="Réengagement" Tag="Reengagement"/>
                            <ComboBoxItem Content="Reclassement" Tag="Reclassement"/>
                        </ComboBox>
                        <TextBlock Text="Date d'effet" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <DatePicker x:Name="DateEffetPicker" Padding="8,6" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Pension attribuée" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <CheckBox x:Name="PensionBox" Content="Oui" Margin="0,8,0,10"/>
                        <TextBlock Text="Type de pension" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="TypePensionBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Motif / Observations" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="ObservationsBox" Padding="8,6" BorderBrush="#D1D5DB"
                         BorderThickness="1" Height="70" AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
