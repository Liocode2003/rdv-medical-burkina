<Window x:Class="CarnetSante.WPF.Views.Patient.Modules.ConstanteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvelle Mesure des Constantes"
        Width="580" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Annuler" Click="BtnAnnuler_Click"
                    Background="#6B7280" Foreground="White"
                    BorderThickness="0" Padding="15,8" Margin="5,0" Cursor="Hand"/>
            <Button Content="Enregistrer" Click="BtnEnregistrer_Click"
                    Background="#1A3A5C" Foreground="White"
                    BorderThickness="0" Padding="15,8" Cursor="Hand"/>
        </StackPanel>

        <ScrollViewer DockPanel.Dock="Top">
            <StackPanel>
                <!-- Date et médecin -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Date de mesure *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <DatePicker x:Name="DateMesurePicker" Padding="8,6" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Médecin mesureur" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="MedecinBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

                <!-- Anthropométrie -->
                <TextBlock Text="Anthropométrie" FontWeight="Bold" Foreground="#1A3A5C"
                           FontSize="13" Margin="0,8,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Taille (cm)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="TailleBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Poids (kg)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="PoidsBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="IMC (auto)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="ImcBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" IsReadOnly="True" Background="#F9FAFB"
                                 Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

                <!-- Signes vitaux -->
                <TextBlock Text="Signes vitaux" FontWeight="Bold" Foreground="#1A3A5C"
                           FontSize="13" Margin="0,4,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="TA Systolique (mmHg)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="TASystoBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                        <TextBlock Text="FC (bpm)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="FcBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="TA Diastolique (mmHg)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="TADiastoBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                        <TextBlock Text="FR (cycles/min)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="FrBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Température (°C)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="TempBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                        <TextBlock Text="SpO2 (%)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="Spo2Box" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

                <!-- Biologie -->
                <TextBlock Text="Analyses biologiques" FontWeight="Bold" Foreground="#1A3A5C"
                           FontSize="13" Margin="0,4,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Glycémie (g/L)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="GlycemieBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Albumine (g/L)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="AlbumineBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Observations" FontWeight="SemiBold" Margin="0,4,0,3"/>
                <TextBox x:Name="ObservationsBox" Padding="8,6" BorderBrush="#D1D5DB"
                         BorderThickness="1" Height="70" AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
