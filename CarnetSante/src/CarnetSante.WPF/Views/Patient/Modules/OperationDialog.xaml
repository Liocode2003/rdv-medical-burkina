<Window x:Class="CarnetSante.WPF.Views.Patient.Modules.OperationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvelle Opération Médicale"
        Width="580" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Annuler" Click="BtnAnnuler_Click"
                    Background="#6B7280" Foreground="White"
                    BorderThickness="0" Padding="15,8" Margin="5,0" Cursor="Hand"/>
            <Button Content="Enregistrer" Click="BtnEnregistrer_Click"
                    Background="#1A3A5C" Foreground="White"
                    BorderThickness="0" Padding="15,8" Cursor="Hand"/>
        </StackPanel>

        <ScrollViewer DockPanel.Dock="Top">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Date de l'opération *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <DatePicker x:Name="DateOperationPicker" Padding="8,6" Margin="0,0,0,10"/>
                        <TextBlock Text="Type d'intervention" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox x:Name="TypeInterventionBox" Padding="8,6" Margin="0,0,0,10">
                            <ComboBoxItem Content="Chirurgicale"/>
                            <ComboBoxItem Content="Médicale"/>
                            <ComboBoxItem Content="Diagnostique"/>
                            <ComboBoxItem Content="Rééducation"/>
                            <ComboBoxItem Content="Urgence"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Lieu de séjour" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="LieuSejourBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1" Margin="0,0,0,10"/>
                        <TextBlock Text="Médecin/Chirurgien" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="MedecinBox" Padding="8,6" BorderBrush="#D1D5DB"
                                 BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Diagnostic *" FontWeight="SemiBold" Margin="0,10,0,3"/>
                <TextBox x:Name="DiagnosticBox" Padding="8,6" BorderBrush="#D1D5DB"
                         BorderThickness="1" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                         Margin="0,0,0,10"/>

                <TextBlock Text="État avant l'opération" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="EtatAvantBox" Padding="8,6" BorderBrush="#D1D5DB"
                         BorderThickness="1" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                         Margin="0,0,0,10"/>

                <TextBlock Text="État après l'opération" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="EtatApresBox" Padding="8,6" BorderBrush="#D1D5DB"
                         BorderThickness="1" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                         Margin="0,0,0,10"/>

                <TextBlock Text="Observations" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="ObservationsBox" Padding="8,6" BorderBrush="#D1D5DB"
                         BorderThickness="1" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
