<UserControl x:Class="CarnetSante.WPF.Views.PatientListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Gestion des Patients" Style="{StaticResource SectionHeader}" FontSize="22"/>
                <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                    <Run Text="dossier(s) médical(aux)"/>
                </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding CreatePatientCommand}"
                    Style="{StaticResource BtnPrimary}"
                    Content="+ Nouveau Patient"
                    VerticalAlignment="Center" Padding="20,10" Height="42"/>
        </Grid>

        <!-- Search Bar -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TxtField}"
                         Height="38" BorderThickness="0"
                         Background="Transparent"/>
                <TextBlock Grid.Column="0" IsHitTestVisible="False"
                           Text="Rechercher par nom, matricule ou numéro de carnet..."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                           VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="1" Command="{Binding SearchCommand}"
                        Style="{StaticResource BtnPrimary}"
                        Content="Rechercher" Margin="8,0,0,0" Height="38"/>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Patients}"
                      SelectedItem="{Binding SelectedPatient}"
                      Style="{StaticResource ProDataGrid}"
                      BorderThickness="0">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenPatientCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N° CARNET" Binding="{Binding NumeroCarnet}" Width="130"/>
                    <DataGridTextColumn Header="MATRICULE" Binding="{Binding Matricule}" Width="120"/>
                    <DataGridTextColumn Header="NOM" Binding="{Binding Nom}" Width="150"/>
                    <DataGridTextColumn Header="PRÉNOMS" Binding="{Binding Prenoms}" Width="200"/>
                    <DataGridTextColumn Header="DATE NAISS." Width="110">
                        <DataGridTextColumn.Binding>
                            <Binding Path="DateNaissance" StringFormat="{}{0:dd/MM/yyyy}"/>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="SEXE" Binding="{Binding Sexe}" Width="80"/>
                    <DataGridTextColumn Header="GR. SANGUIN" Binding="{Binding GroupeSanguin}" Width="100"/>
                    <DataGridTextColumn Header="TÉLÉPHONE" Binding="{Binding Telephone}" Width="120"/>
                    <DataGridTemplateColumn Header="ACTIONS" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,0">
                                    <Button Command="{Binding DataContext.OpenPatientCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource BtnSecondary}"
                                            Content="Ouvrir" Height="30" Padding="12,4"
                                            Margin="0,0,6,0"/>
                                    <Button Command="{Binding DataContext.DeletePatientCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            Style="{StaticResource BtnDanger}"
                                            Content="Supprimer" Height="30" Padding="12,4"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="5" Padding="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</UserControl>
