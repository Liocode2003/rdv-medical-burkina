<Window x:Class="CarnetSante.WPF.Views.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="CarnetSanté - Tableau de Bord"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8">

    <Window.Resources>
        <!-- Style carte statistique -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Margin" Value="8"/>
        </Style>

        <!-- Style bouton menu -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D4A6C"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style ligne patient dans liste -->
        <Style x:Key="PatientRowStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>  <!-- Sidebar -->
            <ColumnDefinition Width="*"/>    <!-- Contenu principal -->
        </Grid.ColumnDefinitions>

        <!-- ════ SIDEBAR GAUCHE ════════════════════════════════ -->
        <Border Grid.Column="0" Background="#1A3A5C">
            <DockPanel>
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Background="#0F2540" Padding="15,20">
                    <StackPanel>
                        <TextBlock Text="🏥 CarnetSanté" FontSize="16" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Burkina Faso" FontSize="11"
                                   Foreground="#64B5F6" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Profil utilisateur -->
                <Border DockPanel.Dock="Top" Background="#152E4D" Padding="15,12" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="{Binding NomUtilisateur}" Foreground="White"
                                   FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding RoleUtilisateur}" Foreground="#64B5F6"
                                   FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Menu de navigation -->
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="NAVIGATION" Foreground="#4A6A8A" FontSize="10"
                               FontWeight="Bold" Margin="15,0,0,8"/>

                    <Button Content="📋  Tableau de Bord" Style="{StaticResource MenuButtonStyle}"
                            Command="{Binding ChargerPatientsCommand}"/>
                    <Button Content="👥  Liste des Patients" Style="{StaticResource MenuButtonStyle}"
                            Command="{Binding ChargerPatientsCommand}"/>
                    <Button Content="➕  Nouveau Patient" Style="{StaticResource MenuButtonStyle}"
                            Command="{Binding NouveauPatientCommand}"/>

                    <Separator Background="#2D4A6C" Margin="15,10"/>
                    <TextBlock Text="ADMINISTRATION" Foreground="#4A6A8A" FontSize="10"
                               FontWeight="Bold" Margin="15,0,0,8"/>
                    <Button Content="📊  Journal d'Audit" Style="{StaticResource MenuButtonStyle}"
                            Command="{Binding OuvrirJournalAuditCommand}"
                            Visibility="{Binding EstAdmin, Converter={StaticResource BoolToVisConverter}}"/>
                    <Button Content="💾  Sauvegarde BDD" Style="{StaticResource MenuButtonStyle}"
                            Command="{Binding SauvegarderBDDCommand}"
                            Visibility="{Binding EstAdmin, Converter={StaticResource BoolToVisConverter}}"/>
                    <Button Content="👤  Utilisateurs" Style="{StaticResource MenuButtonStyle}"
                            Command="{Binding OuvrirUtilisateursCommand}"
                            Visibility="{Binding EstAdmin, Converter={StaticResource BoolToVisConverter}}"/>

                    <Separator Background="#2D4A6C" Margin="15,10"/>
                    <TextBlock Text="MON COMPTE" Foreground="#4A6A8A" FontSize="10"
                               FontWeight="Bold" Margin="15,0,0,8"/>
                    <Button Content="🔑  Changer Mot de Passe" Style="{StaticResource MenuButtonStyle}"
                            Command="{Binding OuvrirChangerMdpCommand}"/>
                </StackPanel>

                <!-- Déconnexion en bas -->
                <Border DockPanel.Dock="Bottom" Padding="10">
                    <Button Content="🚪  Déconnexion" Style="{StaticResource MenuButtonStyle}"
                            Command="{Binding DeconnecterCommand}"
                            Foreground="#F87171"/>
                </Border>

                <StackPanel/>
            </DockPanel>
        </Border>

        <!-- ════ CONTENU PRINCIPAL ═════════════════════════════ -->
        <DockPanel Grid.Column="1" Margin="0">

            <!-- Barre du haut -->
            <Border DockPanel.Dock="Top" Background="White" Padding="20,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.1" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Gestion des Carnets de Santé"
                               FontSize="18" FontWeight="Bold" Foreground="#1A3A5C"
                               VerticalAlignment="Center"/>

                    <!-- Barre de recherche -->
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" Padding="30,8,10,8"
                                 BorderBrush="#CBD5E0"/>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="14"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="#94A3B8" IsHitTestVisible="False"/>
                        <Button Grid.Column="1" Content="Rechercher"
                                Command="{Binding RechercherCommand}"
                                Background="#1A3A5C" Foreground="White"
                                BorderThickness="0" Padding="15,8" Margin="8,0,0,0" Cursor="Hand"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Messages globaux (succès / erreur) -->
            <Border DockPanel.Dock="Top" Background="#DCFCE7" Padding="12,8" Margin="20,10,20,0"
                    CornerRadius="6"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#166534" FontSize="13"/>
            </Border>
            <Border DockPanel.Dock="Top" Background="#FEE2E2" Padding="12,8" Margin="20,10,20,0"
                    CornerRadius="6"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="13"/>
            </Border>

            <!-- Zone principale -->
            <Grid DockPanel.Dock="Top" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Statistiques rapides -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{Binding TotalPatients}" FontSize="32"
                                       FontWeight="Bold" Foreground="#1A3A5C"/>
                            <TextBlock Text="Total Patients" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="📅" FontSize="28"/>
                            <TextBlock Text="{Binding Source={x:Static sys:DateTime.Today},
                                               StringFormat='dd MMM yyyy'}"
                                       FontSize="14" FontWeight="Bold" Foreground="#1A3A5C"/>
                            <TextBlock Text="Date du jour" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🏥" FontSize="28"/>
                            <TextBlock Text="Système Actif" FontSize="14"
                                       FontWeight="Bold" Foreground="#16A34A"/>
                            <TextBlock Text="État du serveur" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel>
                            <Button Content="➕ Nouveau Patient"
                                    Command="{Binding NouveauPatientCommand}"
                                    Background="#1A3A5C" Foreground="White"
                                    BorderThickness="0" Padding="12,8"
                                    FontWeight="Bold" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Liste des patients -->
                <Border Grid.Row="1" Background="White" CornerRadius="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                    </Border.Effect>
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#F8FAFC"
                                CornerRadius="10,10,0,0" Padding="15,10" BorderThickness="0,0,0,1"
                                BorderBrush="#E2E8F0">
                            <TextBlock Text="Liste des Patients" FontWeight="Bold"
                                       FontSize="14" Foreground="#1A3A5C"/>
                        </Border>

                        <ListView x:Name="PatientListView"
                                  ItemsSource="{Binding Patients}"
                                  SelectedItem="{Binding PatientSelectionne}"
                                  ItemContainerStyle="{StaticResource PatientRowStyle}"
                                  BorderThickness="0"
                                  MouseDoubleClick="PatientListView_MouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="N° Carnet" Width="120"
                                                    DisplayMemberBinding="{Binding NumeroCarnet}"/>
                                    <GridViewColumn Header="Nom" Width="140"
                                                    DisplayMemberBinding="{Binding EtatCivil.Nom}"/>
                                    <GridViewColumn Header="Prénoms" Width="160"
                                                    DisplayMemberBinding="{Binding EtatCivil.Prenoms}"/>
                                    <GridViewColumn Header="Date Naissance" Width="110"
                                                    DisplayMemberBinding="{Binding EtatCivil.DateNaissance,
                                                                          StringFormat='dd/MM/yyyy'}"/>
                                    <GridViewColumn Header="Matricule" Width="110"
                                                    DisplayMemberBinding="{Binding EtatCivil.NumeroMatricule}"/>
                                    <GridViewColumn Header="Grade" Width="100"
                                                    DisplayMemberBinding="{Binding EtatCivil.Grade}"/>
                                    <GridViewColumn Header="Unité" Width="130"
                                                    DisplayMemberBinding="{Binding EtatCivil.Unite}"/>
                                    <GridViewColumn Header="Actions" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Ouvrir"
                                                            Click="BtnOuvrir_Click"
                                                            Tag="{Binding}"
                                                            Background="#1A3A5C" Foreground="White"
                                                            BorderThickness="0" Padding="8,4"
                                                            Margin="2" Cursor="Hand" FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
