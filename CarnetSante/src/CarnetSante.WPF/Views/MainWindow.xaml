<Window x:Class="CarnetSante.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CarnetSante.WPF.ViewModels"
        xmlns:views="clr-namespace:CarnetSante.WPF.Views"
        Title="{Binding WindowTitle}"
        Width="1400" Height="860"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <!-- Logo & Title -->
                <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryDarkBrush}" Padding="16,20">
                    <StackPanel>
                        <TextBlock Text="CarnetSante" FontSize="20" FontWeight="Bold"
                                   Foreground="White" FontFamily="Segoe UI"/>
                        <TextBlock Text="Ministère de la Santé" FontSize="11"
                                   Foreground="#90CAF9" Margin="0,4,0,0"/>
                        <TextBlock Text="Burkina Faso" FontSize="11"
                                   Foreground="#90CAF9"/>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top" Margin="0,16,0,0">
                    <!-- Dashboard -->
                    <Button Command="{Binding NavigateToDashboardCommand}"
                            Style="{StaticResource BtnBase}"
                            BorderThickness="0" Height="50" Cursor="Hand">
                        <Button.Background>
                            <SolidColorBrush Color="{Binding IsDashboardActive, Converter={StaticResource BoolToSidebarColor}}"/>
                        </Button.Background>
                        <Grid Width="188">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" x:Name="DashIndicator"
                                    Background="{StaticResource PrimaryLightBrush}"
                                    CornerRadius="0,2,2,0"
                                    Visibility="{Binding IsDashboardActive, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Grid.Column="1" Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Tableau de bord" Foreground="White"
                                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Patients -->
                    <Button Command="{Binding NavigateToPatientsCommand}"
                            Style="{StaticResource BtnBase}"
                            BorderThickness="0" Height="50" Cursor="Hand">
                        <Button.Background>
                            <SolidColorBrush Color="{Binding IsPatientsActive, Converter={StaticResource BoolToSidebarColor}}"/>
                        </Button.Background>
                        <Grid Width="188">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{StaticResource PrimaryLightBrush}"
                                    CornerRadius="0,2,2,0"
                                    Visibility="{Binding IsPatientsActive, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Grid.Column="1" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Patients" Foreground="White"
                                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Footer info -->
                <Border DockPanel.Dock="Bottom" Padding="16,12" BorderThickness="0,1,0,0"
                        BorderBrush="#2C3E50">
                    <StackPanel>
                        <TextBlock Text="CarnetSante v2.0" FontSize="11" Foreground="#607D8B"/>
                        <TextBlock Text="© 2025 MSB" FontSize="10" Foreground="#455A64"/>
                    </StackPanel>
                </Border>

                <Grid/>
            </DockPanel>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Column="1">
            <!-- Dashboard -->
            <views:DashboardView DataContext="{Binding DashboardVM}"
                Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window},
                             Converter={StaticResource PageToVisibility}, ConverterParameter=Dashboard}"/>

            <!-- Patient List -->
            <views:PatientListView DataContext="{Binding PatientListVM}"
                Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window},
                             Converter={StaticResource PageToVisibility}, ConverterParameter=Patients}"/>

            <!-- Patient Detail -->
            <views:PatientDetailView DataContext="{Binding PatientDetailVM}"
                Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window},
                             Converter={StaticResource PageToVisibility}, ConverterParameter=PatientDetail}"/>
        </Grid>
    </Grid>
</Window>
