<Window x:Class="CarnetSante.WPF.Views.Admin.GestionUtilisateursWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Gestion des Utilisateurs"
        Width="950" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#F0F4F8">

    <DockPanel Margin="15">

        <!-- En-tête -->
        <Border DockPanel.Dock="Top" Background="#1A3A5C" CornerRadius="8" Padding="15,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="👤  Gestion des Comptes Utilisateurs"
                           FontSize="16" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="➕ Nouvel Utilisateur"
                        Click="BtnNouvelUtilisateur_Click"
                        Background="#16A34A" Foreground="White"
                        BorderThickness="0" Padding="14,8" Cursor="Hand" FontWeight="Bold">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#15803D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Messages -->
        <Border DockPanel.Dock="Top" Background="#DCFCE7" CornerRadius="5" Padding="10,7" Margin="0,0,0,8"
                Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding SuccessMessage}" Foreground="#166534" FontSize="13"/>
        </Border>
        <Border DockPanel.Dock="Top" Background="#FEE2E2" CornerRadius="5" Padding="10,7" Margin="0,0,0,8"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="13"/>
        </Border>

        <!-- Barre d'actions -->
        <Border DockPanel.Dock="Bottom" Background="White" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🔄 Actualiser"
                        Command="{Binding ChargerCommand}"
                        Background="#374151" Foreground="White"
                        BorderThickness="0" Padding="12,7" Margin="0,0,8,0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1F2937"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="🔑 Réinitialiser Mot de Passe"
                        Command="{Binding ReinitialiserMdpCommand}"
                        Background="#D97706" Foreground="White"
                        BorderThickness="0" Padding="12,7" Margin="0,0,8,0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#B45309"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#94A3B8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="✅ Activer / Désactiver"
                        Command="{Binding ActiverDesactiverCommand}"
                        Background="#1A3A5C" Foreground="White"
                        BorderThickness="0" Padding="12,7" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2D5A8E"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#94A3B8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- Liste des utilisateurs -->
        <Border Background="White" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <ListView x:Name="UsersListView"
                      ItemsSource="{Binding Utilisateurs}"
                      SelectedItem="{Binding UtilisateurSelectionne}"
                      BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Login" Width="110"
                                        DisplayMemberBinding="{Binding Login}"/>
                        <GridViewColumn Header="Nom" Width="130"
                                        DisplayMemberBinding="{Binding Nom}"/>
                        <GridViewColumn Header="Prénoms" Width="130"
                                        DisplayMemberBinding="{Binding Prenom}"/>
                        <GridViewColumn Header="Rôle" Width="130"
                                        DisplayMemberBinding="{Binding Role}"/>
                        <GridViewColumn Header="Email" Width="180"
                                        DisplayMemberBinding="{Binding Email}"/>
                        <GridViewColumn Header="Actif" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EstActif, StringFormat='{}{0}'}"
                                               Foreground="{Binding EstActif,
                                                   Converter={StaticResource BoolToVisConverter}}"
                                               FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstActif}" Value="True">
                                                        <Setter Property="Text" Value="✔ Actif"/>
                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EstActif}" Value="False">
                                                        <Setter Property="Text" Value="✖ Inactif"/>
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Dernière connexion" Width="*">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DerniereConnexion,
                                                       StringFormat='dd/MM/yyyy HH:mm',
                                                       TargetNullValue='Jamais'}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Border>
    </DockPanel>
</Window>
