<Window x:Class="CarnetSante.WPF.Views.Admin.NouvelUtilisateurDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvel Utilisateur"
        Width="480" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F4F8">

    <DockPanel Margin="25">
        <!-- Boutons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Annuler" Click="BtnAnnuler_Click"
                    Background="#6B7280" Foreground="White"
                    BorderThickness="0" Padding="15,8" Margin="0,0,8,0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Créer l'utilisateur" Click="BtnCreer_Click"
                    Background="#1A3A5C" Foreground="White"
                    BorderThickness="0" Padding="15,8" Cursor="Hand" FontWeight="Bold">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2D5A8E"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <ScrollViewer DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock Text="Créer un compte utilisateur" FontSize="16" FontWeight="Bold"
                           Foreground="#1A3A5C" Margin="0,0,0,20"/>

                <TextBlock Text="Login *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="LoginBox" Padding="8,6" BorderBrush="#D1D5DB"
                         BorderThickness="1" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Nom *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="NomBox" Padding="8,6" BorderBrush="#D1D5DB" BorderThickness="1"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Prénoms *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="PrenomBox" Padding="8,6" BorderBrush="#D1D5DB" BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="EmailBox" Padding="8,6" BorderBrush="#D1D5DB"
                         BorderThickness="1" Margin="0,0,0,10"/>

                <TextBlock Text="Rôle *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <ComboBox x:Name="RoleCombo" Padding="8,6" Margin="0,0,0,10"
                          SelectedIndex="1">
                    <ComboBoxItem Content="Administrateur" Tag="Administrateur"/>
                    <ComboBoxItem Content="Médecin" Tag="Medecin"/>
                    <ComboBoxItem Content="Consultation (Lecture seule)" Tag="Consultation"/>
                </ComboBox>

                <TextBlock Text="Mot de passe *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <PasswordBox x:Name="MdpBox" Padding="8,6" BorderBrush="#D1D5DB"
                             BorderThickness="1" Margin="0,0,0,6"/>

                <TextBlock Text="Confirmer le mot de passe *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <PasswordBox x:Name="MdpConfirmBox" Padding="8,6" BorderBrush="#D1D5DB"
                             BorderThickness="1" Margin="0,0,0,10"/>

                <Border x:Name="ErrorBorder" Background="#FEE2E2" CornerRadius="5" Padding="10,8"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
