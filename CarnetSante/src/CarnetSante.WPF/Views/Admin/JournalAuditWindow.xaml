<Window x:Class="CarnetSante.WPF.Views.Admin.JournalAuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Journal d'Audit"
        Width="1100" Height="650"
        WindowStartupLocation="CenterOwner"
        Background="#F0F4F8">

    <DockPanel Margin="15">

        <!-- En-tête -->
        <Border DockPanel.Dock="Top" Background="#1A3A5C" CornerRadius="8" Padding="15,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="📊  Journal d'Audit – Traçabilité des actions"
                           FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding PageLabel}"
                           FontSize="13" Foreground="#A8C8E8" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Messages erreur -->
        <Border DockPanel.Dock="Top" Background="#FEE2E2" CornerRadius="5" Padding="10,7" Margin="0,0,0,8"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="13"/>
        </Border>

        <!-- Navigation pagination -->
        <Border DockPanel.Dock="Bottom" Background="White" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="◀ Page précédente"
                        Command="{Binding PagePrecedenteCommand}"
                        Background="#374151" Foreground="White"
                        BorderThickness="0" Padding="14,8" Margin="0,0,10,0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#94A3B8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{Binding PageLabel}" FontSize="14" FontWeight="Bold"
                           Foreground="#1A3A5C" VerticalAlignment="Center" Margin="20,0"/>
                <Button Content="Page suivante ▶"
                        Command="{Binding PageSuivanteCommand}"
                        Background="#1A3A5C" Foreground="White"
                        BorderThickness="0" Padding="14,8" Margin="10,0,0,0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#94A3B8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- DataGrid journal -->
        <Border Background="White" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding Entrees}"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" BorderThickness="0"
                      Background="White" AlternatingRowBackground="#F8FAFC"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                      SelectionMode="Single" FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date / Heure" Width="130"
                                        Binding="{Binding DateAction, StringFormat='dd/MM/yyyy HH:mm'}"/>
                    <DataGridTextColumn Header="Utilisateur" Width="110"
                                        Binding="{Binding LoginUtilisateur}"/>
                    <DataGridTextColumn Header="Action" Width="140"
                                        Binding="{Binding TypeAction}"/>
                    <DataGridTextColumn Header="Entité" Width="130"
                                        Binding="{Binding EntiteAffectee}"/>
                    <DataGridTextColumn Header="ID entité" Width="70"
                                        Binding="{Binding IdEntiteAffectee}"/>
                    <DataGridTextColumn Header="Patient ID" Width="80"
                                        Binding="{Binding PatientId}"/>
                    <DataGridTextColumn Header="Description" Width="*"
                                        Binding="{Binding Description}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Machine" Width="110"
                                        Binding="{Binding NomMachine}"/>
                    <DataGridTextColumn Header="IP" Width="110"
                                        Binding="{Binding AdresseIP}"/>
                </DataGrid.Columns>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#374151"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
