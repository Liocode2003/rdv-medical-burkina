{
  "Application": {
    "Nom": "CarnetSante",
    "Version": "1.0.0",
    "Organisation": "Ministère de la Santé - Burkina Faso"
  },
  "Database": {
    "ChiffrementActif": false,
    "MotDePasseChiffrement": "",
    "SauvegardeAutomatique": true,
    "IntervalSauvegardeHeures": 24
  },
  "Securite": {
    "MaxTentativesConnexion": 5,
    "DureeBloquageMinutes": 30,
    "DureeSessionHeures": 8,
    "NecessiteChangementMdpInitial": true
  },
  "PDF": {
    "DossierExport": "%USERPROFILE%\\Documents\\CarnetSante\\Exports",
    "LogoPath": "Resources/Icons/logo.png"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
